# Copy to .env and fill in. Do not commit real secrets.

# --- Vite (npm run dev / npm run build / Render Static Site) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_jwt

# Call media: jitsi (default) or livekit
VITE_CALL_PROVIDER=jitsi

# Call audio: Jitsi noise suppression (RNNoise) is always enabled in-app via setNoiseSuppressionEnabled.
# No env vars required — handled automatically on every call join/unmute/device change.

# Render: set the same VITE_* vars in the Static Site env (Dashboard or render.yaml).
# Do NOT set EXPO_PUBLIC_* on Render — those are for Expo/Metro only.

# --- Expo / Metro (npx expo start) — same values as above ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_jwt

# --- CLI & Edge Functions only (never VITE_ prefix for this) ---
VITE_SUPABASE_SERVICE_ROLE=your_service_role_jwt

# --- 8x8 JaaS (Supabase Edge secrets via: supabase secrets set …) ---
# Public meet.jit.si is NOT supported.
#
# 1) Create a JaaS account: https://jaas.8x8.vc
# 2) Dashboard → API keys → generate key → copy App ID, API Key ID (kid), Private Key PEM
# 3) Set secrets (private key as one line with \n or multiline):
#
#   supabase secrets set JITSI_DOMAIN=8x8.vc
#   supabase secrets set JITSI_APP_ID=vpaas-magic-cookie-xxxxxxxx
#   supabase secrets set JITSI_API_KEY_ID=vpaas-magic-cookie-xxxxxxxx/yyyyyyyy
#   supabase secrets set JITSI_API_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#   supabase secrets set APP_URL=http://localhost:5173
#
# Then: node scripts/sync-edge-shared.mjs && supabase functions deploy join-call create-call-session blyve smart-action accept-call invite-participant end-call
#
# After setting R2 secrets (see below), redeploy blyve:
#   supabase functions deploy blyve
#
# --- Self-hosted Jitsi (later) ---
#   JITSI_DOMAIN=jitsi.example.com
#   JITSI_APP_ID=your_app_id
#   JITSI_APP_SECRET=your_hs256_secret

# --- Cloudflare R2 (chat media) — Edge Function secrets only, NEVER VITE_* ---
# Create R2 API token (Object Read & Write) in Cloudflare dashboard.
# EU bucket endpoint (replace YOUR_CLOUDFLARE_ACCOUNT_ID):
#
#   supabase secrets set R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
#   supabase secrets set R2_BUCKET_NAME=blyve
#   supabase secrets set R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.eu.r2.cloudflarestorage.com
#   supabase secrets set R2_ACCESS_KEY_ID=your_r2_access_key_id
#   supabase secrets set R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
#   supabase secrets set R2_PUBLIC_BASE_URL=https://your-r2-public-host.example.com
#
# R2_PUBLIC_BASE_URL: custom domain or R2.dev public URL so clients can display media.
# Without it, uploads work but publicUrl in Supabase stays null until you add a CDN host.
#
# CORS (required for browser uploads from Render / localhost):
# Cloudflare Dashboard → R2 → bucket "blyve" → Settings → CORS policy
# Paste JSON from docs/cloudflare-r2-cors.json (add your production URL if different).
# Without CORS you get: "blocked by CORS policy" on PUT to *.r2.cloudflarestorage.com
#
# Local reference only (do not prefix with VITE_):
R2_ACCOUNT_ID=
R2_BUCKET_NAME=blyve
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.eu.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Optional (display only): public media host for embed detection — not a secret.
# VITE_R2_PUBLIC_BASE_URL=https://your-r2-public-host.example.com

# --- Web Push (PWA notifications when app is closed) ---
# Generate keys: npm run push:vapid
# Public key → VITE_* (client). Private key + subject + webhook secret → Supabase Edge secrets only.
#
#   VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
#
#   supabase secrets set VAPID_PUBLIC_KEY=your_vapid_public_key
#   supabase secrets set VAPID_PRIVATE_KEY=your_vapid_private_key
#   supabase secrets set VAPID_SUBJECT=mailto:hello@yourdomain.com
#   supabase secrets set PUSH_WEBHOOK_SECRET=random_long_secret
#
# Then: supabase db push && supabase functions deploy send-push
# Configure DB webhook settings — see docs/web-push-pwa.md
#
VITE_VAPID_PUBLIC_KEY=BIr3-Htk77D7nJim0z62mcWgyfUkk2rwf9c8BMkdwQPLerKcqKG8DO398xYFndSC9mhGMxfhSN27iMg5ynZ1zvs
